{
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "ESNext",
        "skipLibCheck": true,

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "noEmit": true,

        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "erasableSyntaxOnly": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedSideEffectImports": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["vite.config.ts", "vitest.config.ts", "server/**/*", "scripts/**/*.ts", "code-smell-detector.ts"],
    "// exclude": "Test files belong to tsconfig.test.json, which has DOM and vitest globals. Owning them here too compiled a src/ module that uses `document` against lib ES2022.",
    "exclude": ["server/tests/**/*.test.ts"]
}
