{
    "name": "mdxviewer",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "pnpm@11.10.0",
    "scripts": {
        "dev": "concurrently \"npm run server\" \"vite\"",
        "dev:full": "concurrently \"npm run server\" \"vite\" \"npm run watch:previews\"",
        "client": "vite",
        "server": "API_PORT=${API_PORT:-3001} tsx server/start.ts",
        "start": "NODE_ENV=production API_PORT=${PORT:-3001} tsx server/start.ts",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"{src,server,scripts}/**/*.{ts,tsx,js,jsx,css}\" \"*.{ts,js}\"",
        "format:check": "prettier --check \"{src,server,scripts}/**/*.{ts,tsx,js,jsx,css}\" \"*.{ts,js}\"",
        "test": "vitest",
        "test:run": "vitest run server/tests/",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "verify": "npm run format:check && npm run lint && npm run build && npm run test:run",
        "watch:previews": "node scripts/js/preview-watcher.js",
        "generate:previews": "node scripts/js/generate-previews-safe.js",
        "generate:all-previews": "node scripts/js/generate-all-previews.js",
        "rename:files": "node scripts/js/rename-files-safe.js",
        "code-smell-report": "tsx scripts/code-smell-detector.ts"
    },
    "dependencies": {
        "@deck.gl/core": "9.3.11",
        "@deck.gl/layers": "9.3.11",
        "@deck.gl/react": "9.3.11",
        "@fontsource/archivo": "^5.3.0",
        "@fontsource/bodoni-moda": "^5.3.0",
        "@fontsource/jetbrains-mono": "^5.2.6",
        "@mdx-js/mdx": "^3.1.1",
        "@radix-ui/react-avatar": "^1.1.10",
        "@radix-ui/react-checkbox": "^1.3.2",
        "@radix-ui/react-dialog": "^1.1.14",
        "@radix-ui/react-dropdown-menu": "^2.1.15",
        "@radix-ui/react-label": "^2.1.7",
        "@radix-ui/react-radio-group": "^1.3.7",
        "@radix-ui/react-select": "^2.2.5",
        "@radix-ui/react-separator": "^1.1.7",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-toast": "^1.2.14",
        "@radix-ui/react-tooltip": "^1.2.7",
        "@shikijs/langs": "3.7.0",
        "@tailwindcss/vite": "^4.1.10",
        "@tanstack/react-query": "^5.81.5",
        "@tanstack/react-query-devtools": "^5.81.5",
        "@types/node": "^24.0.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cors": "^2.8.5",
        "express": "^5.1.0",
        "gray-matter": "^4.0.3",
        "katex": "^0.16.22",
        "lucide-react": "^0.522.0",
        "mermaid": "^11.17.2",
        "multer": "^2.0.1",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-markdown": "^10.1.0",
        "react-resizable-panels": "^3.0.3",
        "react-router-dom": "^7.6.2",
        "rehype-katex": "^7.0.1",
        "rehype-raw": "^7.0.0",
        "rehype-sanitize": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "shiki": "^3.7.0",
        "tailwind-merge": "^3.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.25.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/multer": "^1.4.13",
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.1.2",
        "@types/supertest": "^6.0.3",
        "@vitejs/plugin-react": "^4.4.1",
        "@vitest/ui": "^3.2.4",
        "concurrently": "^9.2.0",
        "eslint": "^9.31.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "globals": "^16.0.0",
        "prettier": "^3.6.2",
        "prettier-plugin-tailwindcss": "^0.6.13",
        "supertest": "^7.1.3",
        "tailwindcss": "^4.1.10",
        "tsx": "^4.20.3",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.30.1",
        "vite": "^6.3.5",
        "vitest": "^3.2.4"
    }
}
